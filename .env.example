# Copy this file to .env and fill it in. .env is git-ignored: never commit a real key.
#
# Your juke system's key. You get it once, in the Lab on getjuked.io
# (Lab tab -> Connect your AI -> Connect your own model). See the README.
JUKE_API_KEY=jk_your_system_key

# Optional. Only for a local juke (http://localhost or http://127.0.0.1) or another
# getjuked.io address; the key is never sent to any other host.
# JUKE_BASE_URL=https://www.getjuked.io/api/v3-beta
